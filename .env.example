# ===========================================
# Hermod - Environment Configuration
# Swift messenger of your data
# ===========================================

# Database (required)
DATABASE_URL="postgresql://hermod:hermod@localhost:5432/hermod"

# NextAuth (required)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (required)
# Get these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email delivery is configured per-user in the UI (Connections → Add → SMTP Email)

# Encryption (required for connection password encryption)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# SFTP (optional, for file integrations)
# Docker SFTP server runs on port 2222
SFTP_HOST="localhost"
SFTP_PORT="2222"

# Cloud LLM provider (optional). Used by getLlmProvider for openai/xai/groq/
# anthropic/etc. LLM_MODEL is a CLOUD model name used ONLY by cloud providers
# and the Anthropic fallback — it NEVER reaches the local Ollama box.
# Supported: ollama, anton, openai, xai, groq, together, fireworks, anthropic
LLM_PROVIDER=""
LLM_MODEL=""        # cloud model name; ONLY used by anthropic / openai-compatible
LLM_API_KEY=""
LLM_BASE_URL=""

# Anton AI (optional, server-side only) — Joe's separate agentic RAG service.
# NOT used by Hermod's structured-extraction machinery (reserved for Phase 2,
# Hermod's "voice"). ANTON_API_KEY must be the literal tenant key:
# client_id:client_secret
ANTON_API_BASE_URL=""
ANTON_API_KEY=""
ANTON_MODEL=""

# --- Hermod AI machinery (local Ollama; NOT Anton) ---
# Hermod's INTERNAL, non-user-facing AI (Mjolnir header detection + structural
# inference, Alfheim schema/sheet analysis, sync cursor detection, gate key
# recommendation, UCC column pruning) runs against a local Ollama GPU. Models
# change frequently — set them here; these win over the defaults in code.
HERMOD_OLLAMA_URL="http://192.168.1.181:11434"
HERMOD_OLLAMA_MODEL_FAST="qwen3:8b"        # quick structured/JSON tasks
HERMOD_OLLAMA_MODEL_SMART="nemotron3:33b"  # heavier reasoning tasks
# Cloud fallback (best-effort only, used if the local Ollama call errors):
ANTHROPIC_API_KEY=""
# Legacy alias, still honored as a fallback for HERMOD_OLLAMA_URL:
# OLLAMA_URL="http://192.168.1.181:11434"


# Stripe (required for paid tiers)
# Create products at https://dashboard.stripe.com/products
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_THOR="price_..."
STRIPE_PRICE_ODIN="price_..."

# Shared SES SMTP (optional, for Heimdall/Thor email delivery)
# Odin users bring their own SMTP; Heimdall/Thor use shared SES
SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SES_SMTP_PORT="587"
SES_SMTP_USER=""
SES_SMTP_PASS=""
SES_FROM_ADDRESS="reports@hermodforge.com"
SES_FROM_NAME="Hermod Reports"
